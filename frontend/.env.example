# ─── CARDSAFE Frontend environment ─────────────────────────────
# Copy to `.env.local`. These are the only values safe to expose to the browser.
# Never put API keys, JWT secrets or Cloudinary secrets here.

# Full GraphQL endpoint URL (backend origin + /graphql).
# Production (set in Vercel → Settings → Environment Variables):
#   NEXT_PUBLIC_GRAPHQL_URL=https://cardsafe-ojoi.onrender.com/graphql
# Local development:
#   NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
