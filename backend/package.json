{
  "name": "cardsafe-backend",
  "version": "1.0.0",
  "description": "CARDSAFE gift card trading platform backend (Express + GraphQL + MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "./node_modules/.bin/tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "./node_modules/.bin/tsc -p tsconfig.json && cp -r src/graphql/typeDefs dist/graphql/",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "seed": "./node_modules/.bin/tsx scripts/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "graphql": "^16.9.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.3",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
