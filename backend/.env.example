# ─── CARDSAFE Backend environment ───────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cardsafe

# Optional: comma-separated DNS servers used for MongoDB SRV lookups.
# Set this if an Atlas `mongodb+srv://` URI fails with EBADRESP on your network.
DNS_SERVERS=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary (leave blank to disable uploads until configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional seed (admin bootstrap — used by `npm run seed` only)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
